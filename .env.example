# ==============================================================================
# CyberSage AI - Environment Configuration Example
# Copy this file to .env in local development. Never commit .env with real secrets.
# ==============================================================================

# Core Application Settings
APP_ENV=development
DEBUG=true
PROJECT_NAME="CyberSage AI"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
SECRET_KEY=change_this_to_a_secure_random_string_min_32_chars

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Persistence & Queues (Phase 2+)
DATABASE_URL=sqlite+aiosqlite:///./cybersage.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cybersage
REDIS_URL=redis://localhost:6379/0

# AI Provider Configuration (Phase 3+)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_api_key_here
LLM_TEMPERATURE=0.1

# Sandboxing & Execution Constraints
SANDBOX_EXECUTION_TIMEOUT_SECONDS=60
SANDBOX_MAX_MEMORY_MB=1024
SANDBOX_ALLOW_NETWORK=false

# Scanner Configuration
SEMGREP_RULES_CONFIG=p/default
TRIVY_SEVERITY_THRESHOLD=MEDIUM

# Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
