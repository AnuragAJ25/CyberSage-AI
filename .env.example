# ==============================================================================
# CyberSage AI - Environment Configuration Example
# Copy this file to .env in local development. Never commit .env with real secrets.
# ==============================================================================

# Core Application Settings
APP_ENV=development
DEBUG=true
PROJECT_NAME="CyberSage AI"
API_V1_STR=/api/v1
HOST=0.0.0.0
PORT=8000
# In production, SECRET_KEY must be a cryptographically strong string (min 32 characters)
SECRET_KEY=dev-insecure-secret-key-local-only-not-for-production-min32chars

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Persistence & Queues (Phase 2+)
# Local development default uses SQLite:
DATABASE_URL=sqlite+aiosqlite:///./cybersage.db
# For PostgreSQL via Docker Compose:
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_secure_postgres_password_here
# POSTGRES_DB=cybersage
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
REDIS_URL=redis://localhost:6379/0

# Scanner Engine Initial MVP Configuration (Phase 2)
# Core MVP scanners: Semgrep (SAST), OSV-Scanner (SCA), Gitleaks (Secrets)
SEMGREP_RULES_CONFIG=p/default
OSV_SCANNER_ENABLED=true
GITLEAKS_ENABLED=true

# AI Provider Configuration (Phase 3+)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_api_key_here
LLM_TEMPERATURE=0.1

# Sandboxing & Execution Constraints (Phase 4+)
SANDBOX_EXECUTION_TIMEOUT_SECONDS=60
SANDBOX_MAX_MEMORY_MB=1024
SANDBOX_ALLOW_NETWORK=false

# Frontend Public Variables
NEXT_PUBLIC_API_URL=http://localhost:8000
